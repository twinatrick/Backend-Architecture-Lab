# Common
RESTART_POLICY=always

# PostgreSQL
POSTGRES_IMAGE=postgres:latest
POSTGRES_CONTAINER_NAME=postgres_db_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Redis
REDIS_IMAGE=redis:latest
REDIS_CONTAINER_NAME=redis_container
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379
REDIS_HOST=
REDIS_CACHE_TTL_HOURS=1

# Zookeeper
ZOOKEEPER_IMAGE=confluentinc/cp-zookeeper:7.2.1
ZOOKEEPER_CONTAINER_NAME=zookeeper
ZOOKEEPER_PORT=2181

# Kafka
KAFKA_IMAGE=confluentinc/cp-kafka:7.2.1
KAFKA_CONTAINER_NAME=kafka
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost

# MinIO
MINIO_IMAGE=minio/minio:latest
MINIO_CONTAINER_NAME=gary-backend-minio
MINIO_USER=minioadmin
MINIO_PASSWORD=your_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Milvus
MILVUS_VERSION=v2.4.5
MILVUS_CONTAINER_NAME=gary-backend-milvus
MILVUS_POSTGRES_HOST=postgres
MILVUS_POSTGRES_PORT=5432
MILVUS_TOKEN=milvus-default-token
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091

# Attu
ATTU_IMAGE=zilliz/attu:latest
ATTU_CONTAINER_NAME=gary-backend-attu
ATTU_PORT=8001
MILVUS_ROOT_USER=root
MILVUS_ROOT_PASSWORD=your_milvus_password

# JWT
JWT_SECRET_USE=change_to_your_jwt_secret
JWT_ISSUER=BackendArchitectureLab
JWT_AUDIENCE=BackendArchitectureLab
JWT_EXPIRATION_MINUTES=1440

# Backend app runtime (for Spring Boot)
# APP_IN_DOCKER=true when backend runs in Docker container
APP_IN_DOCKER=false
# External system sync (competency): 預設停用；啟用時需同時設定 EXTERNAL_SYNC_BASE_URL
EXTERNAL_SYNC_ENABLED=false
EXTERNAL_SYNC_BASE_URL=
KAFKA_BOOTSTRAP_SERVERS=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password
SERVER_PORT=8000

# ── LINE 女友機器人 ──
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# ── LINE 女友機器人 ──
LINE_GF_CHANNEL_SECRET=
LINE_GF_CHANNEL_ACCESS_TOKEN=

# ── LINE 語音日記 ──
LINE_DIARY_CHANNEL_ID=
LINE_DIARY_CHANNEL_SECRET=
LINE_DIARY_CHANNEL_ACCESS_TOKEN=

# ── Discord 女友機器人 ──
DISCORD_GF_TOKEN=

# ── Discord 語音日記 ──
DISCORD_DIARY_TOKEN=

# MinIO for external-api-service
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-audio

# Python Whisper STT Model Configuration
# WHISPER_MODEL_SIZE=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# Python AI Sidecar
AI_PY_PORT=5001
GPT_SOVIT_REF_AUDIO_MINIO_KEY=tts-refs/girlfriend-voice.wav
GPT_SOVIT_PROMPT_TEXT=いいんじゃない。最近、一緒に歌ってる人の声に合わせられるようになってきたし
GPT_SOVIT_PROMPT_LANG=ja

# JMeter Load Testing
JMETER_BIN=C:\fake\path\to\apache-jmeter\bin\jmeter.bat
